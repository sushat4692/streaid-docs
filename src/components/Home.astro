---
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Introduction from "./Introduction.astro";
import Install from "./Install.astro";
import History from "./History.astro";
import Author from "./Author.astro";
import Footer from "./Footer.astro";
import { site, type Locale } from "../data/site";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const copy = site[locale];
const alternate = locale === "en" ? "/jp/" : "/";
---

<Layout
    lang={copy.htmlLang}
    title={copy.metaTitle}
    description={copy.description}
    alternate={alternate}
>
    <Nav locale={locale} />
    <Hero appName={copy.appName} tagline={copy.tagline} />

    <main>
        <Introduction
            header={copy.intro.header}
            description={copy.intro.description}
            features={copy.intro.features}
        />
        <Install {...copy.install} />
        <History header={copy.history.header} locale={locale} />
        <Author header={copy.author.header} helpText={copy.author.helpText} />
    </main>

    <Footer text={copy.footer} />
</Layout>
